# Bevel OS builds for two boards. Settings the two have in common are here; board-specific ones
# live in sdkconfig.defaults.esp32s3 (ESP32-S3 devkit, resistor DAC into a VGA monitor) and
# sdkconfig.defaults.esp32p4 (Guition JC1060P470-V2, 7" MIPI-DSI panel).
#
# Choose the board with:   idf.py set-target esp32s3      or      idf.py set-target esp32p4
# The sdkconfig file follows whichever target was set last; the defaults files above fully
# determine it, so deleting sdkconfig and configuring again gives a clean board configuration.

CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# Both boards have PSRAM (8 MB octal on the S3, 32 MB on the P4); speed and mode are per board.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
# skip the memory test at boot (saves about a second)
CONFIG_SPIRAM_MEMTEST=n

CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_FREERTOS_HZ=1000
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y

# USB host: keyboard and mouse, through a hub or splitter. Composite keyboards have a large
# configuration descriptor, and some hubs do not answer the first request without patient timing.
CONFIG_USB_HOST_HUBS_SUPPORTED=y
CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=2048
CONFIG_USB_HOST_DEBOUNCE_DELAY_MS=500
CONFIG_USB_HOST_RESET_HOLD_MS=60
CONFIG_USB_HOST_RESET_RECOVERY_MS=120
CONFIG_USB_HOST_SET_ADDR_RECOVERY_MS=30

# The drive: a wear-levelled FAT filesystem in the internal flash (partition table per board)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=64
CONFIG_WL_SECTOR_SIZE_4096=y
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=n

# Network and HTTPS for the browser: keep their buffers out of the scarce internal RAM
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y

# JPEG in the picture viewer: shrinking while decoding (the S3 turns its ROM decoder off for this),
# the faster Huffman tables, and a read buffer that suits files on FAT
CONFIG_JD_SZBUF=4096
CONFIG_JD_FASTDECODE_TABLE=y
