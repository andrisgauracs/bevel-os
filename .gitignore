# ESP-IDF build output and component-manager downloads. Each board builds in its own build-<target>
# directory (CMakePresets.json) with its sdkconfig there; "build" only holds the serial log.
build/
build-*/
managed_components/
/sdkconfig
sdkconfig.old

# Doom game data: fetched by tools/fetch_doom.sh, never committed
third_party/wad/
*.wad
*.WAD

# Generated previews and raw framebuffer dumps
tools/assets/out/
*.ppm

# Local clutter
.DS_Store
__pycache__/
*.pyc

# Editor setup the ESP-IDF extension writes per machine (toolchain paths, COM port, clangd)
.vscode/settings.json
.clangd
