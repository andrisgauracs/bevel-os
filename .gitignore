# ESP-IDF build output and component-manager downloads. One build directory per board is handy
# (idf.py -B build-esp32s3 ...); the plain "build" one is what tools/flash.ps1 uses.
build/
build-*/
managed_components/
sdkconfig.old

# Doom game data: fetched by tools/fetch_doom.sh, never committed
third_party/wad/
*.wad
*.WAD

# Generated previews and raw framebuffer dumps
tools/assets/out/
*.ppm

# Local clutter
.DS_Store
__pycache__/
*.pyc
