# ESP32-S3 (QFN56 rev v0.2) devkit: 16 MB flash, 8 MB octal PSRAM (N16R8), resistor DAC into a
# VGA monitor at 640x480, keyboard and mouse on a USB-C breakout. Hardware notes: docs/NOTES.md
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# The apps in disk/Apps/esp32s3 import newlib's internals (__errno, __getreent) through the loader's
# symbol table, so keep newlib: ESP-IDF 6.1 picks picolibc for this chip by default, where
# __getreent is a macro and there is no __errno at all.
CONFIG_LIBC_NEWLIB=y

# PSRAM: 8 MB octal (N16R8)
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# Bigger data cache helps PSRAM -> bounce buffer throughput
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

# The VGA scan-out is fed by an interrupt: it must keep running while a flash write has the cache
# switched off, and its DMA restarts at vsync.
CONFIG_LCD_RGB_ISR_IRAM_SAFE=y
CONFIG_LCD_RGB_RESTART_IN_VSYNC=y

# Console, logs and the serial command channel on UART0 (the board's COM port), at 2 Mbaud: what a
# devkit with a CP210x bridge carries. A devkit with a CH340 loses bytes at that rate; build it with
# the esp32s3-ch340 preset, which adds sdkconfig.defaults.ch340 (460800).
CONFIG_ESP_CONSOLE_UART_CUSTOM=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=2000000

# Storage: 12 MB FAT drive in the internal flash (no card reader on this board)
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_esp32s3.csv"

# Wi-Fi is the S3's own radio: its buffers in PSRAM, and no IRAM tricks that would eat internal RAM
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
